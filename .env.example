# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Phase 1 does not read any of these yet; they are wired up from Phase 2 onward.

# Postgres (docker-compose.yml reads these; defaults shown)
POSTGRES_DB=lookalike
POSTGRES_USER=lookalike
POSTGRES_PASSWORD=lookalike

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM / embedding provider key (planned, Phase 2-3)
LLM_API_KEY=
