# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# The defaults work without a .env: the offline embedder and ranker need no key.

# Postgres (docker-compose.yml and the app read these; defaults shown)
POSTGRES_DB=lookalike
POSTGRES_USER=lookalike
POSTGRES_PASSWORD=lookalike
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (embedding cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Real provider, used only with SPRING_PROFILES_ACTIVE=openai.
# Any OpenAI-compatible server works. For a local Ollama server use
# OPENAI_BASE_URL=http://localhost:11434 and any non-empty key.
# The vector table is created with LOOKALIKE_AI_EMBEDDING_DIMENSIONS columns, so set it to the
# embedding model's size (1536 for text-embedding-3-small) and re-ingest after switching models.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOOKALIKE_AI_EMBEDDING_DIMENSIONS=1536
